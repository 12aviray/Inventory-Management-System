<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.SalesController"
            styleClass="main-panel">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="12"/>
            </padding>
            <Label text="Sales &amp; Customer Dispatch" styleClass="view-title"/>
            <Label text="Sell products to customers, automatically deducting warehouse stock and logging OUT audit movements." styleClass="view-subtitle"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.52" orientation="HORIZONTAL">
            <!-- Left: Sale Checkout Form & Cart -->
            <VBox spacing="10">
                <padding>
                    <Insets right="8"/>
                </padding>

                <TitledPane text="1. Sale Details &amp; Warehouse" collapsible="false">
                    <GridPane hgap="12" vgap="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <Label text="Customer Name / Ref:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="customerField" promptText="e.g. John Doe / Invoice #1042" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240"/>

                        <Label text="Fulfilling Warehouse *:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="warehouseCombo" promptText="Select warehouse..." GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="240"/>
                    </GridPane>
                </TitledPane>

                <TitledPane text="2. Add Products to Cart" collapsible="false">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Product *:" styleClass="form-label"/>
                            <ComboBox fx:id="productCombo" prefWidth="220" promptText="Select product..."/>
                            <Label fx:id="availableStockLabel" text="Available: - " styleClass="badge-info"/>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Quantity *:" styleClass="form-label"/>
                            <TextField fx:id="quantityField" prefWidth="90" promptText="e.g. 5"/>

                            <Label text="Price ($) *:" styleClass="form-label"/>
                            <TextField fx:id="priceField" prefWidth="90" promptText="e.g. 15.00"/>

                            <Button text="+ Add to Cart" onAction="#handleAddToCart" styleClass="btn-secondary"/>
                            <Button text="Remove" onAction="#handleRemoveFromCart" styleClass="btn-danger-outline"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <!-- Cart TableView -->
                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <Label text="Current Sales Cart:" styleClass="section-header"/>
                    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="cartProductCol" text="Product" prefWidth="200"/>
                            <TableColumn fx:id="cartQtyCol" text="Quantity" prefWidth="80"/>
                            <TableColumn fx:id="cartPriceCol" text="Unit Price ($)" prefWidth="100"/>
                            <TableColumn fx:id="cartSubtotalCol" text="Subtotal ($)" prefWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Cart is empty. Select a product and click '+ Add to Cart'."/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Cart Checkout Panel -->
                <VBox spacing="8" styleClass="card-panel">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2">
                            <Label fx:id="cartItemCountLabel" text="Items: 0" style="-fx-font-weight: bold;"/>
                            <Label fx:id="cartTotalAmountLabel" text="Grand Total: $0.00" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: #16a34a;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🛒 Complete Sale &amp; Dispatch" onAction="#handleCheckout" styleClass="btn-success" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Button text="Clear Cart" onAction="#handleClearCart" styleClass="btn-outline"/>
                    </HBox>
                    <Label fx:id="statusLabel" styleClass="status-msg"/>
                </VBox>
            </VBox>

            <!-- Right: Recent Sales Audit Log -->
            <VBox spacing="8">
                <padding>
                    <Insets left="8"/>
                </padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Recent Sales &amp; Dispatch History:" styleClass="section-header"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="↻ Refresh Log" onAction="#handleRefreshSalesLog" styleClass="btn-sm"/>
                </HBox>
                <TableView fx:id="salesLogTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="logDateCol" text="Date &amp; Time" prefWidth="140"/>
                        <TableColumn fx:id="logProductCol" text="Product" prefWidth="160"/>
                        <TableColumn fx:id="logWarehouseCol" text="Warehouse" prefWidth="130"/>
                        <TableColumn fx:id="logQtyCol" text="Qty" prefWidth="60"/>
                        <TableColumn fx:id="logReasonCol" text="Customer &amp; Notes" prefWidth="220"/>
                    </columns>
                    <placeholder>
                        <Label text="No sales recorded yet."/>
                    </placeholder>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
