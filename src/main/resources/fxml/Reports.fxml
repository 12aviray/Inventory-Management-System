<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.ReportsController"
            styleClass="main-panel">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="12"/>
            </padding>
            <Label text="Reports &amp; Analytics" styleClass="view-title"/>
            <Label text="Generate low stock alerts using pluggable strategies and audit inventory movements with custom filters." styleClass="view-subtitle"/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="reportTabs" tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: LOW STOCK REPORT -->
            <Tab text="Low Stock Report">
                <BorderPane>
                    <padding>
                        <Insets top="12" right="8" bottom="8" left="8"/>
                    </padding>
                    <top>
                        <TitledPane text="Reorder Strategy Configuration" collapsible="false">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                                <Label text="Active Strategy:" styleClass="form-label"/>
                                <ComboBox fx:id="strategyCombo" prefWidth="250"/>

                                <Button text="⚡ Run Low Stock Report" onAction="#handleLowStockReport" styleClass="btn-primary"/>
                                <Label fx:id="lowStockSummaryLabel" styleClass="badge-info"/>
                            </HBox>
                        </TitledPane>
                    </top>

                    <center>
                        <VBox spacing="8">
                            <padding>
                                <Insets top="10"/>
                            </padding>
                            <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="lsProductColumn" text="Product Name" prefWidth="240"/>
                                    <TableColumn fx:id="lsWarehouseColumn" text="Warehouse" prefWidth="180"/>
                                    <TableColumn fx:id="lsQuantityColumn" text="Current Stock" prefWidth="120"/>
                                    <TableColumn fx:id="lsThresholdColumn" text="Reorder Threshold" prefWidth="140"/>
                                    <TableColumn fx:id="lsSuggestedColumn" text="Suggested Order Qty" prefWidth="160"/>
                                </columns>
                                <placeholder>
                                    <Label text="No items currently require restocking under this strategy."/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- TAB 2: MOVEMENT HISTORY REPORT -->
            <Tab text="Stock Movement History &amp; Audit Log">
                <BorderPane>
                    <padding>
                        <Insets top="12" right="8" bottom="8" left="8"/>
                    </padding>
                    <top>
                        <TitledPane text="Filter Movement History" collapsible="false">
                            <VBox spacing="10">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="Product:" styleClass="form-label"/>
                                    <ComboBox fx:id="filterProductCombo" prefWidth="200" promptText="All Products"/>

                                    <Label text="Warehouse:" styleClass="form-label"/>
                                    <ComboBox fx:id="filterWarehouseCombo" prefWidth="180" promptText="All Warehouses"/>

                                    <Label text="From Date:" styleClass="form-label"/>
                                    <DatePicker fx:id="fromDatePicker" prefWidth="140" promptText="Start Date"/>

                                    <Label text="To Date:" styleClass="form-label"/>
                                    <DatePicker fx:id="toDatePicker" prefWidth="140" promptText="End Date"/>
                                </HBox>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Button text="🔍 Apply Filters" onAction="#handleMovementReport" styleClass="btn-primary"/>
                                    <Button text="Reset Filters" onAction="#handleResetMovementFilters" styleClass="btn-outline"/>
                                    <Label fx:id="movementCountLabel" styleClass="badge-info"/>
                                </HBox>
                            </VBox>
                        </TitledPane>
                    </top>

                    <center>
                        <VBox spacing="8">
                            <padding>
                                <Insets top="10"/>
                            </padding>
                            <TableView fx:id="movementTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="mvDateColumn" text="Date &amp; Time" prefWidth="160"/>
                                    <TableColumn fx:id="mvProductColumn" text="Product Name" prefWidth="200"/>
                                    <TableColumn fx:id="mvWarehouseColumn" text="Warehouse" prefWidth="150"/>
                                    <TableColumn fx:id="mvTypeColumn" text="Movement Type" prefWidth="130"/>
                                    <TableColumn fx:id="mvQuantityColumn" text="Quantity" prefWidth="90"/>
                                    <TableColumn fx:id="mvReasonColumn" text="Reason / Reference" prefWidth="260"/>
                                </columns>
                                <placeholder>
                                    <Label text="No stock movements match the specified filter criteria."/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- TAB 3: FINANCIAL & PROFIT/LOSS REPORT -->
            <Tab text="Financial &amp; Profit/Loss Analytics">
                <BorderPane>
                    <padding>
                        <Insets top="12" right="8" bottom="8" left="8"/>
                    </padding>
                    <top>
                        <VBox spacing="12">
                            <TitledPane text="Filter Financial Reporting Period" collapsible="false">
                                <VBox spacing="10">
                                    <padding>
                                        <Insets top="10" right="10" bottom="10" left="10"/>
                                    </padding>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="Warehouse:" styleClass="form-label"/>
                                        <ComboBox fx:id="finWarehouseCombo" prefWidth="200" promptText="All Warehouses"/>

                                        <Label text="From Date:" styleClass="form-label"/>
                                        <DatePicker fx:id="finFromDatePicker" prefWidth="140" promptText="Start Date"/>

                                        <Label text="To Date:" styleClass="form-label"/>
                                        <DatePicker fx:id="finToDatePicker" prefWidth="140" promptText="End Date"/>

                                        <Button text="🔍 Compute Financials" onAction="#handleFinancialReport" styleClass="btn-primary"/>
                                        <Button text="Reset Filters" onAction="#handleResetFinancialFilters" styleClass="btn-outline"/>
                                    </HBox>
                                </VBox>
                            </TitledPane>

                            <!-- Financial Summary KPI Cards -->
                            <HBox spacing="12">
                                <VBox styleClass="kpi-card, kpi-green" HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="PERIOD REVENUE" styleClass="kpi-title"/>
                                    <Label fx:id="finRevenueLabel" text="\$0.00" styleClass="kpi-value"/>
                                    <Label text="Customer sales total" styleClass="kpi-sub"/>
                                </VBox>
                                <VBox styleClass="kpi-card, kpi-amber" HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="COST OF GOODS (COGS)" styleClass="kpi-title"/>
                                    <Label fx:id="finCogsLabel" text="\$0.00" styleClass="kpi-value"/>
                                    <Label text="Direct inventory cost" styleClass="kpi-sub"/>
                                </VBox>
                                <VBox styleClass="kpi-card, kpi-blue" HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="GROSS PROFIT" styleClass="kpi-title"/>
                                    <Label fx:id="finProfitLabel" text="\$0.00" styleClass="kpi-value"/>
                                    <Label fx:id="finMarginLabel" text="Margin: 0.0%" styleClass="kpi-sub" style="-fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                                </VBox>
                                <VBox styleClass="kpi-card, kpi-blue" HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="INVENTORY VALUATION" styleClass="kpi-title"/>
                                    <Label fx:id="finInventoryValLabel" text="\$0.00" styleClass="kpi-value"/>
                                    <Label fx:id="finUnitsSoldLabel" text="Units Sold: 0" styleClass="kpi-sub"/>
                                </VBox>
                                <VBox styleClass="kpi-card, kpi-amber" HBox.hgrow="ALWAYS" spacing="2">
                                    <Label text="PROCUREMENT EXPENSE" styleClass="kpi-title"/>
                                    <Label fx:id="finProcurementLabel" text="\$0.00" styleClass="kpi-value"/>
                                    <Label text="Total restock purchases" styleClass="kpi-sub"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </top>

                    <center>
                        <VBox spacing="8">
                            <padding>
                                <Insets top="10"/>
                            </padding>
                            <Label text="Per-Product Profitability Breakdown:" styleClass="section-header"/>
                            <TableView fx:id="finProfitTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="finProdNameCol" text="Product Name" prefWidth="220"/>
                                    <TableColumn fx:id="finUnitsSoldCol" text="Units Sold" prefWidth="100"/>
                                    <TableColumn fx:id="finUnitCostCol" text="Unit Cost ($)" prefWidth="110"/>
                                    <TableColumn fx:id="finAvgPriceCol" text="Avg Sell Price ($)" prefWidth="130"/>
                                    <TableColumn fx:id="finRevenueCol" text="Total Revenue ($)" prefWidth="130"/>
                                    <TableColumn fx:id="finCogsCol" text="Total Cost ($)" prefWidth="120"/>
                                    <TableColumn fx:id="finProfitCol" text="Net Profit ($)" prefWidth="120"/>
                                    <TableColumn fx:id="finMarginCol" text="Margin (%)" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No sales recorded for the selected period."/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
