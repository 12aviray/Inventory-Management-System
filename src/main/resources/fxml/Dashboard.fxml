<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.DashboardController">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <VBox spacing="6">
            <Label text="Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="16">
                <Label fx:id="lowStockCountLabel" style="-fx-font-size: 14px;"/>
                <Label fx:id="totalProductsLabel" style="-fx-font-size: 14px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="6">
            <padding>
                <Insets top="10"/>
            </padding>
            <Label text="Items needing reorder:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="lowStockTable">
                <columns>
                    <TableColumn fx:id="productColumn" text="Product" prefWidth="220"/>
                    <TableColumn fx:id="warehouseColumn" text="Warehouse" prefWidth="150"/>
                    <TableColumn fx:id="quantityColumn" text="Quantity" prefWidth="100"/>
                    <TableColumn fx:id="thresholdColumn" text="Threshold" prefWidth="100"/>
                    <TableColumn fx:id="suggestedColumn" text="Suggested Order Qty" prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="8">
            <padding>
                <Insets top="10"/>
            </padding>
            <Button text="Refresh" onAction="#handleRefresh"/>
        </HBox>
    </bottom>
</BorderPane>
