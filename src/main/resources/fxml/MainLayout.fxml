<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.MainLayoutController">
    <left>
        <VBox spacing="6" style="-fx-background-color: #2b2b2b;" prefWidth="170">
            <padding>
                <Insets top="16" right="10" bottom="16" left="10"/>
            </padding>
            <Label text="Inventory System" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Separator/>
            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"/>
            <Button text="Products" onAction="#showProducts" maxWidth="Infinity"/>
            <Button text="Warehouse Stock" onAction="#showWarehouseStock" maxWidth="Infinity"/>
            <Button text="Create Purchase Order" onAction="#showPurchaseOrderCreate" maxWidth="Infinity"/>
            <Button text="Receive Shipment" onAction="#showReceiveShipment" maxWidth="Infinity"/>
            <Button text="Transfer Stock" onAction="#showTransfer" maxWidth="Infinity"/>
            <Button text="Reports" onAction="#showReports" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
