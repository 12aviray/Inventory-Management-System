<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.ProductListController"
            styleClass="main-panel">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <top>
        <VBox spacing="10">
            <padding>
                <Insets bottom="12"/>
            </padding>
            <Label text="Product Management" styleClass="view-title"/>
            <Label text="Manage the master catalog of products, reorder thresholds, and unit costs." styleClass="view-subtitle"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Search Products:" styleClass="form-label"/>
                <TextField fx:id="searchField" prefWidth="300" promptText="Filter by SKU, Name, or Category..."/>
                <Button text="Clear Filter" onAction="#handleClearSearch" styleClass="btn-sm"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Refresh List" onAction="#handleRefresh" styleClass="btn-sm"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="productTable">
            <columns>
                <TableColumn fx:id="skuColumn" text="SKU" prefWidth="120"/>
                <TableColumn fx:id="nameColumn" text="Product Name" prefWidth="250"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                <TableColumn fx:id="costColumn" text="Unit Cost ($)" prefWidth="120"/>
                <TableColumn fx:id="thresholdColumn" text="Reorder Threshold" prefWidth="150"/>
            </columns>
            <placeholder>
                <Label text="No products found matching the criteria."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="12"/>
            </padding>
            <TitledPane text="Product Details Form (Add / Edit)" collapsible="false">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <GridPane hgap="12" vgap="10">
                        <Label text="SKU *:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="skuField" promptText="e.g. SKU-006" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="180"/>

                        <Label text="Product Name *:" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
                        <TextField fx:id="nameField" promptText="e.g. Mechanical Keyboard" GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="240"/>

                        <Label text="Category *:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="categoryField" promptText="e.g. Electronics" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="180"/>

                        <Label text="Unit Cost ($) *:" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
                        <TextField fx:id="costField" promptText="e.g. 45.00" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="180"/>

                        <Label text="Reorder Threshold *:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <TextField fx:id="thresholdField" promptText="e.g. 15" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="180"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="+ Add Product" onAction="#handleAdd" styleClass="btn-primary"/>
                        <Button text="✎ Update Selected" onAction="#handleUpdate" styleClass="btn-secondary"/>
                        <Button text="✖ Delete Selected" onAction="#handleDelete" styleClass="btn-danger"/>
                        <Button text="Clear Form / New" onAction="#handleClearForm" styleClass="btn-outline"/>
                        <Label fx:id="statusLabel" styleClass="status-msg"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>
    </bottom>
</BorderPane>
