<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.inventory.ui.controller.TransferController"
            styleClass="main-panel">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="12"/>
            </padding>
            <Label text="Stock Transfer" styleClass="view-title"/>
            <Label text="Move stock atomically between warehouses using the Command pattern (TransferStockCommand)." styleClass="view-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16">
            <TitledPane text="Inter-Warehouse Transfer Form" collapsible="false">
                <VBox spacing="14">
                    <padding>
                        <Insets top="14" right="14" bottom="14" left="14"/>
                    </padding>
                    <GridPane hgap="16" vgap="14">
                        <!-- Row 0: Product -->
                        <Label text="Product to Transfer *:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="productCombo" prefWidth="280" promptText="Select product..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <!-- Row 1: Source & Dest Warehouse -->
                        <Label text="Source Warehouse (From) *:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <ComboBox fx:id="fromWarehouseCombo" prefWidth="220" promptText="Select source warehouse..."/>
                            <Label fx:id="availableStockLabel" text="Available Stock: - " styleClass="badge-info"/>
                        </HBox>

                        <Label text="Destination Warehouse (To) *:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
                        <ComboBox fx:id="toWarehouseCombo" prefWidth="220" promptText="Select destination warehouse..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <!-- Row 2: Quantity -->
                        <Label text="Transfer Quantity *:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                            <TextField fx:id="quantityField" prefWidth="120" promptText="e.g. 20"/>
                            <Button text="Transfer All Available" onAction="#handleTransferAll" styleClass="btn-sm"/>
                        </HBox>
                    </GridPane>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button text="⇄ Execute Stock Transfer" onAction="#handleTransfer" styleClass="btn-primary"/>
                        <Button text="Clear" onAction="#handleClear" styleClass="btn-outline"/>
                        <Label fx:id="statusLabel" styleClass="status-msg"/>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- Recent Transfer Log -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label text="Recent Stock Transfer Log:" styleClass="section-header"/>
                <TableView fx:id="recentTransfersTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="tfDateColumn" text="Date &amp; Time" prefWidth="150"/>
                        <TableColumn fx:id="tfProductColumn" text="Product" prefWidth="200"/>
                        <TableColumn fx:id="tfWarehouseColumn" text="Warehouse" prefWidth="160"/>
                        <TableColumn fx:id="tfTypeColumn" text="Type" prefWidth="130"/>
                        <TableColumn fx:id="tfQtyColumn" text="Quantity" prefWidth="100"/>
                        <TableColumn fx:id="tfReasonColumn" text="Reason / Details" prefWidth="260"/>
                    </columns>
                    <placeholder>
                        <Label text="No stock movements recorded yet."/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
